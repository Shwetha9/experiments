# Growing Human is off by default. Do not enable it until the approved staging
# red-team evaluation and human review in docs/superpowers/specs/2026-09-26-growing-human-design.md §5.6.
GROWING_HUMAN_ENABLE_GUIDE=false

# Server-only OpenRouter settings. Never expose these values to the Angular app,
# commit a real key, or enable browser-side provider access.
OPENROUTER_API_KEY=
# Pinned Jev classifier and a non-OpenAI chat model example:
OPENROUTER_JEV_MODEL=typesafe/jev-1.13
OPENROUTER_CHAT_MODEL=anthropic/claude-sonnet-5

# Server-only API Ninjas Quotes setting. Set this in Vercel as
# API_NINJAS_API_KEY; never put it in the Angular bundle.
API_NINJAS_API_KEY=

# Optional: defaults to https://openrouter.ai/api/v1 and 8000ms (500–30000 allowed).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_MS=8000
