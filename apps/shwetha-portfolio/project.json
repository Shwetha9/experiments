{
  "name": "shwetha-portfolio",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/shwetha-portfolio/src",
  "prefix": "app",
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "defaultConfiguration": "production",
      "outputs": ["{options.outputPath}"],
      "options": {
        "browser": "apps/shwetha-portfolio/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/shwetha-portfolio/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/shwetha-portfolio/public"
          }
        ],
        "styles": ["apps/shwetha-portfolio/src/styles.scss"],
        "outputPath": "dist/shwetha-portfolio"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kB",
              "maximumError": "1MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "10kB",
              "maximumError": "10kB"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "shwetha-portfolio:build:production"
        },
        "development": {
          "buildTarget": "shwetha-portfolio:build:development"
        }
      },
      "dependsOn": ["api:serve"],
      "options": {
        "proxyConfig": "apps/shwetha-portfolio/proxy.conf.json"
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n"
    },
    "test": {
      "executor": "@angular/build:karma",
      "options": {
        "polyfills": ["zone.js", "zone.js/testing"],
        "tsConfig": "apps/shwetha-portfolio/tsconfig.spec.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/shwetha-portfolio/public"
          }
        ],
        "styles": ["apps/shwetha-portfolio/src/styles.scss"]
      }
    }
  }
}
