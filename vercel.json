{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/site",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "dist/apps/api/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/growing-human",
      "destination": "/growing-human/index.html"
    },
    {
      "source": "/growing-human/:path*",
      "destination": "/growing-human/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
